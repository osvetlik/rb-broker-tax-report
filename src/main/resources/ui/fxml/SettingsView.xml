<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<StackPane xmlns:fx="http://javafx.com/fxml" styleClass="centered-stack" alignment="CENTER">
	<VBox>
    <Label text="Settings" styleClass="header"/>
    <Separator orientation="HORIZONTAL" />
		<Region VBox.vgrow="ALWAYS"/>
		<HBox>
			<Region HBox.hgrow="ALWAYS"/>
			<VBox>
				<HBox>
					<VBox HBox.hgrow="ALWAYS">
						<HBox VBox.vgrow="ALWAYS">
							<Label text="IMAP Server:" />
						</HBox>
						<HBox VBox.vgrow="ALWAYS">
							<Label text="IMAP Port:" />
						</HBox>
						<HBox VBox.vgrow="ALWAYS">
							<Label text="IMAP Folder:" />
						</HBox>
						<HBox VBox.vgrow="ALWAYS">
							<Label text="Working Directory:" />
						</HBox>
					</VBox>
					<VBox HBox.hgrow="ALWAYS">
						<HBox VBox.vgrow="ALWAYS">
							<TextField fx:id="imapServerField" promptText="" HBox.hgrow="ALWAYS"/>
						</HBox>
						<HBox VBox.vgrow="ALWAYS">
							<TextField fx:id="imapPortField" promptText="" HBox.hgrow="ALWAYS"/>
						</HBox>
						<HBox VBox.vgrow="ALWAYS">
							<TextField fx:id="imapFolderField" promptText="" HBox.hgrow="ALWAYS"/>
						</HBox>
						<HBox VBox.vgrow="ALWAYS" styleClass="no-gap">
							<TextField fx:id="workingDirField" />
							<Button text="Browse" onAction="#onBrowse" />
						</HBox>
					</VBox>
		    </HBox>
				<HBox>
					<Region HBox.hgrow="ALWAYS"/>
					<Button text="Reset" onAction="#onReset" />
					<Button text="Save" onAction="#onSave" />
				</HBox>
			</VBox>
			<Region HBox.hgrow="ALWAYS"/>
		</HBox>
		<Region VBox.vgrow="ALWAYS"/>
	</VBox>
</StackPane>
