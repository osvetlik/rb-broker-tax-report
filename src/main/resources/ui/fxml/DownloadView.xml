<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ProgressBar?>
<StackPane xmlns:fx="http://javafx.com/fxml">
	<VBox>
    <Label text="Download" styleClass="header"/>
    <Separator orientation="HORIZONTAL" />
		<Region VBox.vgrow="ALWAYS"/>
		<HBox>
			<Region HBox.hgrow="ALWAYS"/>
			<VBox>
				<HBox>
					<VBox HBox.hgrow="ALWAYS">
						<HBox VBox.vgrow="ALWAYS">
							<Label text="Login:" />
						</HBox>
						<HBox VBox.vgrow="ALWAYS">
							<Label text="Password:" />
						</HBox>
					</VBox>
					<VBox HBox.hgrow="ALWAYS">
						<HBox VBox.vgrow="ALWAYS">
							<TextField fx:id="loginField" promptText="" HBox.hgrow="ALWAYS"/>
						</HBox>
						<HBox VBox.vgrow="ALWAYS">
							<PasswordField fx:id="passwordField" promptText="" HBox.hgrow="ALWAYS"/>
						</HBox>
					</VBox>
		    </HBox>
				<HBox>
					<Region HBox.hgrow="ALWAYS"/>
					<Button text="Download" onAction="#onDownload" fx:id="downloadButton"/>
					<Button text="Cancel" onAction="#onCancel" disable="true" fx:id="cancelButton"/>
				</HBox>
				<HBox>
					<ProgressBar fx:id="downloadProgress" HBox.hgrow="ALWAYS" progress="0.0"/>
				</HBox>
			</VBox>
			<Region HBox.hgrow="ALWAYS"/>
		</HBox>
		<Region VBox.vgrow="ALWAYS"/>
	</VBox>
</StackPane>
