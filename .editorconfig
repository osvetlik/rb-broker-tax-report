root = true

[*]
charset = utf-8

[*.java]
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = tab
indent_size = 4

[*.js]
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = tab
indent_size = 2

[*.css]
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = tab
indent_size = 2

[*.xml]
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = tab
indent_size = 2

[*.fxml]
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = tab
indent_size = 2
